NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"

# Auth (use a long random string in real deployments)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE_MS=86400000

# CORS + links inside emails
FRONTEND_URL=http://localhost:3000

# SMTP (Mailpit from docker-compose; inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop Software <no-reply@brightloop.com>"

# Auth rate limiting
AUTH_RATE_LIMIT=5
AUTH_RATE_LIMIT_TTL_MS=60000
